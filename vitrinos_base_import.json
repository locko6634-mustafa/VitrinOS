    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"intent\": {\n      \"type\": \"string\",\n      \"enum\": [\"Meta Post\", \"Story\", \"Banner\"]\n    },\n    \"visual_details\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"product_name\": { \"type\": \"string\" },\n        \"category\": { \"type\": \"string\" },\n        \"slogan\": { \"type\": \"string\" },\n        \"image_url\": { \"type\": \"string\" },\n        \"width\": { \"type\": \"integer\", \"description\": \"Genişlik\" },\n        \"height\": { \"type\": \"integer\", \"description\": \"Yükseklik\" },\n        \"prices\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"old_price\": { \"type\": \"string\" },\n            \"new_price\": { \"type\": \"string\" },\n            \"discount_rate\": { \"type\": \"string\" }\n          }\n        },\n        \"campaign\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"campaign_name\": { \"type\": \"string\" },\n            \"campaign_code\": { \"type\": \"string\" }\n          }\n        }\n      },\n      \"required\": [\"product_name\", \"category\", \"slogan\"]\n    }\n  },\n  \"required\": [\"intent\", \"visual_details\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        580,
        480
      ],
      "id": "structured-parser-node",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nlet payload = input.output ?? input.text ?? input;\n\nif (typeof payload === 'string') {\n  try {\n    const match = payload.match(/```(?:json)?\\s*\\n?([\\s\\S]*?)\\n?\\s*```/);\n    let cleanJson = match ? match[1].trim() : payload.trim();\n    const jsonMatch = cleanJson.match(/\\{[\\s\\S]*\\}/);\n    if (jsonMatch) {\n      cleanJson = jsonMatch[0];\n    }\n    payload = JSON.parse(cleanJson);\n  } catch (error) {\n    payload = {};\n  }\n}\n\nconst intent = ['Meta Post', 'Story', 'Banner'].includes(payload.intent)\n  ? payload.intent\n  : 'Meta Post';\n\nconst details = payload.visual_details ?? {};\nconst prices = details.prices ?? {};\nconst campaign = details.campaign ?? {};\n\nfunction defaultWidth(intentValue, value) {\n  const parsed = Number.parseInt(value, 10);\n  if (intentValue === 'Meta Post') return 1080;\n  if (intentValue === 'Story') return 1080;\n  return Number.isFinite(parsed) && parsed > 0 ? parsed : 1600;\n}\n\nfunction defaultHeight(intentValue, value) {\n  const parsed = Number.parseInt(value, 10);\n  if (intentValue === 'Meta Post') return 1350;\n  if (intentValue === 'Story') return 1920;\n  return Number.isFinite(parsed) && parsed > 0 ? parsed : 600;\n}\n\nconst normalized = {\n  intent,\n  visual_details: {\n    product_name: String(details.product_name ?? '').trim(),\n    category: String(details.category ?? '').trim(),\n    slogan: String(details.slogan ?? '').trim(),\n    image_url: String(details.image_url ?? '').trim(),\n    width: defaultWidth(intent, details.width),\n    height: defaultHeight(intent, details.height),\n    prices: {\n      old_price: String(prices.old_price ?? '').trim(),\n      new_price: String(prices.new_price ?? '').trim(),\n      discount_rate: String(prices.discount_rate ?? '').trim(),\n    },\n    campaign: {\n      campaign_name: String(campaign.campaign_name ?? '').trim(),\n      campaign_code: String(campaign.campaign_code ?? '').trim(),\n    },\n  },\n};\n\nreturn [\n  {\n    json: {\n      output: normalized,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
