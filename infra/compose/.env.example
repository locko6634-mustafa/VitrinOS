# VitrinOS Local Environment Variables Example

# Node Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/vitrinos

# n8n Webhook Security (HMAC verification)
N8N_WEBHOOK_SECRET=temporary_webhook_secret_for_local_dev

# S3 / MinIO Local Configuration
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET_NAME=vitrinos-assets
S3_FORCE_PATH_STYLE=true

# Transactional SMTP Settings (For mock testing locally, we can use console or simple mailer)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=mock
SMTP_PASSWORD=mock
SMTP_SECURE=false
MAIL_FROM="VitrinOS <mock@vitrinos.local>"
APP_URL=http://localhost:8000
