{
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test quality/tests/config.test.mjs quality/tests/frontend-contract.test.mjs quality/tests/responsive-overflow.test.mjs quality/tests/staging-e2e-gate.test.mjs",
    "release-gate": "node quality/scripts/release-gate.mjs",
    "release-manifest": "node quality/scripts/generate-release-manifest.mjs",
    "ops-check": "node quality/scripts/ops-contract.mjs",
    "check": "npm test && npm run ops-check && npm run release-gate",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "playwright": "^1.45.0",
    "supabase": "^2.109.1",
    "typescript": "^5.5.4",
    "@types/node": "^20.14.10"
  }
}

